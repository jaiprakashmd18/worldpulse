# Copy to .env for local development; set the same variables in Vercel → Project → Settings → Environment Variables.
# Leave the Supabase values empty to run in demo mode.

# Supabase → Project Settings → API → Project URL
WORLDPULSE_SUPABASE_URL=
# Supabase → Project Settings → API → anon / publishable key. NEVER the service_role / secret key.
WORLDPULSE_SUPABASE_ANON_KEY=

# Optional
WORLDPULSE_POLL_INTERVAL_MS=60000
WORLDPULSE_CONTACT_EMAIL=
WORLDPULSE_GITHUB_URL=
# Public address shown in the hero and footer
WORLDPULSE_SITE_URL=https://ghost-gobal.vercel.app
